---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = '艾戈',
  description = '艾戈的个人博客：关于 AI 模型与工具的观察和笔记。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="艾戈" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">艾戈</a>
      <nav>
        <a href="/">首页</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© 2026 艾戈 · <a href="/rss.xml">RSS</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --width: 720px;
    --font-main: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', Helvetica, Arial, sans-serif;
    --font-code: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --text-color: #1f1f1f;
    --muted-color: #6b6b6b;
    --bg-color: #ffffff;
    --border-color: #e5e5e5;
    --link-color: #1a4fd6;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text-color: #d8d8d8;
      --muted-color: #9a9a9a;
      --bg-color: #161618;
      --border-color: #2e2e30;
      --link-color: #7ea6ff;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
  }

  body {
    margin: 0;
    padding: 0 16px;
    font-family: var(--font-main);
    color: var(--text-color);
    background: var(--bg-color);
    line-height: 1.7;
  }

  header,
  main,
  footer {
    max-width: var(--width);
    margin: 0 auto;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 20px 0 12px;
  }

  .site-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
  }

  nav a {
    margin-left: 16px;
    color: var(--text-color);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  main {
    padding: 16px 0 48px;
  }

  footer {
    border-top: 1px solid var(--border-color);
    padding: 16px 0 32px;
    color: var(--muted-color);
    font-size: 0.85rem;
  }

  a {
    color: var(--link-color);
  }

  h1,
  h2,
  h3 {
    line-height: 1.35;
  }

  h1 {
    font-size: 1.5rem;
    margin: 0 0 8px;
  }

  .post-meta {
    color: var(--muted-color);
    font-size: 0.85rem;
    margin-bottom: 32px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 6px 0;
  }

  .post-list a {
    text-decoration: none;
  }

  .post-list a:hover {
    text-decoration: underline;
  }

  .post-list time {
    color: var(--muted-color);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  pre,
  code {
    font-family: var(--font-code);
    font-size: 0.9em;
  }

  pre {
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow-x: auto;
  }

  code {
    background: color-mix(in srgb, var(--border-color) 45%, transparent);
    padding: 1px 5px;
    border-radius: 4px;
  }

  pre code {
    background: none;
    padding: 0;
  }

  blockquote {
    margin: 16px 0;
    padding: 0 16px;
    border-left: 3px solid var(--border-color);
    color: var(--muted-color);
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>
