---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = '艾戈',
  description = '艾戈的个人博客：关于 AI 模型与工具的观察和笔记。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="艾戈" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">艾戈</a>
      <nav>
        <a href="/">首页</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© 2026 艾戈 · <a href="/rss.xml">RSS</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --width: 720px;
    --font-main: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
      'Hiragino Sans GB', 'Microsoft YaHei', Helvetica, Arial, sans-serif;
    --font-code: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --text-color: #1a1a1a;
    --muted-color: #6f6f6f;
    --bg-color: #ffffff;
    --border-color: #d9d9d9;
    --soft-bg: #f4f4f2;
    --link-color: #1157d6;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text-color: #d6d6d6;
      --muted-color: #9b9b9b;
      --bg-color: #17171a;
      --border-color: #333338;
      --soft-bg: #222226;
      --link-color: #82aaff;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-size: 19px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0 20px;
    font-family: var(--font-main);
    color: var(--text-color);
    background: var(--bg-color);
    line-height: 1.75;
  }

  header,
  main,
  footer {
    max-width: var(--width);
    margin: 0 auto;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 28px 0 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .site-title {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-color);
    text-decoration: none;
  }

  nav a {
    margin-left: 18px;
    color: var(--link-color);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  main {
    padding: 28px 0 56px;
  }

  footer {
    border-top: 1px solid var(--border-color);
    padding: 18px 0 40px;
    color: var(--muted-color);
    font-size: 0.78rem;
  }

  footer p {
    margin: 0;
  }

  a {
    color: var(--link-color);
  }

  main :global(p) a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--link-color) 45%, transparent);
  }

  main :global(p) a:hover {
    text-decoration-color: currentcolor;
  }

  h1,
  h2,
  h3 {
    line-height: 1.4;
    font-weight: 700;
  }

  h1 {
    font-size: 1.55rem;
    margin: 0 0 10px;
  }

  h2 {
    font-size: 1.25rem;
    margin: 2em 0 0.6em;
  }

  h3 {
    font-size: 1.05rem;
    margin: 1.8em 0 0.5em;
  }

  main :global(p) {
    margin: 0 0 1.15em;
  }

  main :global(ul),
  main :global(ol) {
    padding-left: 1.4em;
    margin: 0 0 1.15em;
  }

  main :global(li) {
    margin-bottom: 0.35em;
  }

  main :global(hr) {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2em 0;
  }

  .post-meta {
    color: var(--muted-color);
    font-size: 0.78rem;
    margin-bottom: 36px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .post-list li:hover {
    background: var(--soft-bg);
  }

  .post-list a {
    font-weight: 600;
    text-decoration: none;
  }

  .post-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-list time {
    color: var(--muted-color);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  pre,
  code {
    font-family: var(--font-code);
    font-size: 0.72em;
  }

  pre {
    padding: 14px 18px;
    background: var(--soft-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.6;
  }

  code {
    background: var(--soft-bg);
    padding: 2px 6px;
    border-radius: 5px;
  }

  pre code {
    background: none;
    padding: 0;
  }

  blockquote {
    margin: 1.2em 0;
    padding: 2px 18px;
    border-left: 3px solid var(--border-color);
    color: var(--muted-color);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2em 0;
    font-size: 0.85rem;
  }

  th,
  td {
    border: 1px solid var(--border-color);
    padding: 6px 10px;
    text-align: left;
  }

  th {
    background: var(--soft-bg);
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  ::selection {
    background: color-mix(in srgb, var(--link-color) 25%, transparent);
  }
</style>
